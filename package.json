{
  "name": "meter-running",
  "private": true,
  "version": "0.0.1",
  "description": "Top-down cab-driver life-sim for browser and phone. Built from phaserjs/template-react-ts.",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^3.2.4"
  }
}
