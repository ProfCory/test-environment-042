<Project Sdk="Microsoft.NET.Sdk">
  <!-- The in-game script. ScriptHookVDotNet loads AnotherLife.Game.dll from GTA V/scripts. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>AnotherLife.InGame</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" ExcludeAssets="runtime" />
    <PackageReference Include="LemonUI.SHVDN3" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AnotherLife.Core/AnotherLife.Core.csproj" />
  </ItemGroup>
</Project>
